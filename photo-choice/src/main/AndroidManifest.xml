<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        android:minSdkVersion="33" />
    <!-- Android 14+ "选择部分照片"授权：缺少此声明时部分授权模式完全不可用 -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        android:minSdkVersion="34" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 库不在 application 节点声明任何属性（如 supportsRtl）：
         library manifest 会 merge 进宿主，属性取值冲突会直接导致宿主构建失败 -->
    <application>
        <activity
            android:name=".ui.PhotoChoiceActivity"
            android:exported="false"
            android:theme="@style/Theme.PhotoChoice"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33" />
        <activity
            android:name=".ui.preview.PreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.PhotoChoice.Preview"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"/>
        <activity
            android:name=".ui.crop.CropActivity"
            android:exported="false"
            android:theme="@style/Theme.PhotoChoice.Crop"
            android:enableOnBackInvokedCallback="true"
            tools:targetApi="33"/>

        <!-- 相机拍照临时文件的 FileProvider。
             authority 用 ${applicationId} 占位符拼接，保证多个集成方之间不冲突
             （两个 App 声明同名 authority 会导致后装的那个安装失败）。
             CameraHelper.fileProviderAuthority() 用 context.packageName 拼出同样的值。

             为什么必须走 FileProvider 而不是直接给相机 MediaStore Uri：
             MediaProvider 对 IS_PENDING=1 的行在 SQL 层按 owner_package 过滤，URI 授权绕不过，
             系统相机拿到的 MediaStore Uri 无法写入，照片会丢失（只剩空目录）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photochoice.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photochoice_file_paths" />
        </provider>
    </application>

</manifest>
