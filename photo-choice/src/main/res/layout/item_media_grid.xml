<?xml version="1.0" encoding="utf-8"?>
<com.google.photochoice.ui.widget.SquareFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    tools:layout_height="120dp"
    tools:layout_width="120dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/photochoice_thumbnail_placeholder"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:id="@+id/thumbnailScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_thumbnail_overlay" />

    <View
        android:id="@+id/disabledOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/photochoice_disabled_overlay"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/livePhotoBadge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/ic_live_photo"
        android:contentDescription="@string/photochoice_live_photo"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivVideoIndicator"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/ic_play"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- GIF 角标：半透明黑底胶囊 + 白字 "GIF"。
         bottom|start 与 Live/播放角标同位对齐(6dp 边距)；GIF 属 IMAGE，与视频/Live 天然互斥不重叠。 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/gifBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_gif_badge"
        android:paddingHorizontal="5dp"
        android:paddingVertical="3dp"
        android:includeFontPadding="false"
        android:text="@string/photochoice_gif_label"
        android:textColor="@color/photochoice_preview_text"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:visibility="gone"
        tools:visibility="visible"
        tools:ignore="SmallSp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:textColor="@color/photochoice_preview_text"
        android:textSize="11sp"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:visibility="gone"
        tools:text="0:12"
        tools:visibility="visible" />

    <View
        android:id="@+id/checkbox"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_checkbox_unselected" />

    <com.google.photochoice.ui.widget.CenteredTextView
        android:id="@+id/tvSelectionOrder"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/photochoice_on_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="1"
        tools:visibility="visible" />

    <View
        android:id="@+id/checkboxTouchArea"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent" />

</com.google.photochoice.ui.widget.SquareFrameLayout>
