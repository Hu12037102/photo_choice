<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/photochoice_preview_bg">

    <com.google.photochoice.ui.crop.CropView
        android:id="@+id/cropView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶栏：与 preview topBar 结构一致 — 外层承载状态栏 inset + 背景，内层 56dp 定高承载按钮 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_gravity="top"
        android:clipToPadding="false"
        android:background="@color/photochoice_preview_topbar_bg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:paddingHorizontal="0dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnCancel"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="@string/photochoice_cancel"
                android:textColor="@color/photochoice_preview_text"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnConfirm"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="@string/photochoice_done"
                android:textColor="@color/photochoice_preview_text"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 底栏：与预览 bottomBar 统一 — 半透明暗底、56dp minHeight、16dp 水平间距 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_gravity="bottom"
        android:clipToPadding="false"
        android:background="@color/photochoice_preview_topbar_bg"
        android:paddingHorizontal="0dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnRatioFree"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="@string/photochoice_crop_free"
            android:textColor="@color/photochoice_icon_secondary"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnRatio11"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="@string/photochoice_crop_ratio_11"
            android:textColor="@color/photochoice_icon_secondary"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnRatioFree"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnRatio34"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="@string/photochoice_crop_ratio_34"
            android:textColor="@color/photochoice_icon_secondary"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnRatio11"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnRatio916"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/photochoice_crop_ratio_916"
            android:textColor="@color/photochoice_icon_secondary"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnRatio34"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
