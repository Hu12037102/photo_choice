<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/previewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/photochoice_preview_bg">

    <com.google.photochoice.ui.widget.BounceLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.photochoice.ui.widget.BounceLayout>

    <!-- 实况图标识：位于标题栏下方左侧，由 PreviewActivity 控制显隐与 topMargin -->
    <include
        android:id="@+id/livePhotoBadge"
        layout="@layout/include_live_photo_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- minHeight 为内容区高度；状态栏 padding 由 PreviewActivity 按 statusBars inset 叠加 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_gravity="top"
        android:clipToPadding="false"
        android:background="@color/photochoice_preview_topbar_bg"
        >
       <androidx.constraintlayout.widget.ConstraintLayout
           android:layout_width="match_parent"
           android:layout_height="56dp"
           app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintBottom_toBottomOf="parent"
           android:paddingHorizontal="0dp"
           >
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_white"
            android:contentDescription="@string/photochoice_back"
            android:background="@drawable/ripple_circle_nav_light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPreviewIndex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/photochoice_preview_text"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/selectionBoxContainer"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/selectionBoxContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/selectionBox"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_checkbox_unselected_preview" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSelectionOrder"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/photochoice_preview_btn_text_enabled"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
       </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 导航栏 padding 由 PreviewActivity 按 navigationBars inset 叠加 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_gravity="bottom"
        android:clipToPadding="false"
        android:background="@color/photochoice_preview_topbar_bg"
        android:paddingHorizontal="0dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:minWidth="80dp"
            android:includeFontPadding="false"
            android:textSize="14sp"
            android:text="@string/photochoice_done"
            android:textColor="@color/photochoice_preview_text"
            android:background="@drawable/ripple_btn_done_preview_disabled"
            android:paddingHorizontal="4dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
