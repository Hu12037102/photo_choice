<?xml version="1.0" encoding="utf-8"?>
<!-- 日期悬浮胶囊背景：表面色圆角矩形 + 顶部受光的渐变发丝边框（top 亮 → bottom 沉），
     模拟光源在上的玻璃边缘质感，配合 elevation 投影呈"悬浮玻璃"观感。
     结构：底层为渐变圆角矩形充当边框，面层内缩 1px 露出发丝线。
     - LayerDrawable.getOutline 取第一个非空子层，故底层圆角 shape 仍为 elevation 提供
       正确的圆角 outline（与 CardView 同源管线）。
     - 投影由 view 的 elevation 走原生管线绘制，本 drawable 只负责面层与轮廓。
       注意：勿给投影色设低透明度 tint——最终透明度 = tint alpha × 主题 spotShadowAlpha，
       相乘后会把影子调没（历史踩坑，见提交记录）。
     - 两层圆角同为 16dp：1px 内缩下的理论内径差异肉眼不可辨，不单独收窄。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 边框层：angle=270 即 startColor 在顶、endColor 在底的纵向渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/photochoice_date_chip_border_top"
                android:endColor="@color/photochoice_date_chip_border_bottom" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- 面层：四边内缩 1px，露出渐变发丝边 -->
    <item
        android:bottom="1px"
        android:left="1px"
        android:right="1px"
        android:top="1px">
        <shape android:shape="rectangle">
            <solid android:color="@color/photochoice_surface" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
